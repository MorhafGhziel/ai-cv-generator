datasource db {
  provider  = "postgresql"
  // The app talks to the pooled endpoint: many short-lived connections from
  // serverless functions are exactly what PgBouncer is for.
  url       = env("DATABASE_URL")
  // Schema changes need a real session. PgBouncer in transaction mode cannot
  // hold the advisory locks `db push` and `migrate` take out, so those go
  // straight to the compute endpoint.
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  cvProfile          Json?
  onboardingComplete Boolean @default(false)

  /// Application preferences used to personalise generated answers.
  /// Previously these were hardcoded into the prompt for a single user.
  preferences Json?

  cvEntries   CvEntry[]
  usageEvents UsageEvent[]
  document    OriginalDocument?
}

/// The CV exactly as the user uploaded it.
///
/// Text extraction discards every design decision a PDF carries — fonts,
/// columns, colour, spacing — so the original bytes are the only way to hand
/// someone their own document back, or to change one value inside it without
/// rebuilding the page. One per user; a new upload replaces it.
model OriginalDocument {
  id         String   @id @default(cuid())
  userId     String   @unique
  filename   String
  bytes      Bytes
  byteSize   Int
  pageCount  Int
  uploadedAt DateTime @default(now())

  /// The editor's saved operation list, replayed onto `bytes` on export.
  ///
  /// Storing the operations rather than an edited file keeps the upload
  /// pristine: every export starts from the same bytes, so repeated saves
  /// cannot compound, and discarding the list is a true revert.
  edits   Json?
  editsAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  // OAuth tokens routinely exceed the default varchar length — a Google
  // id_token is a JWT of well over a kilobyte — so these are explicitly text.
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CvEntry {
  id             String   @id @default(cuid())
  userId         String
  jobSnippet     String
  jobDescription String   @db.Text
  targetCompany  String?
  targetRole     String?
  cvData         Json
  /// Generated screening-form answers, saved so they survive a reload.
  answers        Json?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// One row per billable AI call. Backs the free-tier rate limiter:
/// a sliding window + daily quota computed with a count over `createdAt`.
/// Rows older than the widest window are pruned opportunistically.
model UsageEvent {
  id        String   @id @default(cuid())
  userId    String
  action    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, action, createdAt])
  @@index([createdAt])
}
